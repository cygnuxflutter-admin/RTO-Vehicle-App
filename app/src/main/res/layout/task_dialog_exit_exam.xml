<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Alert Icon Badge -->
            <FrameLayout
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_alert_badge">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_alert_triangle" />
            </FrameLayout>

            <!-- Title -->
            <TextView
                android:id="@+id/tv_exit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/task_roboto_bold"
                android:text="Exit Exam?"
                android:textColor="#0F172A"
                android:textSize="19sp" />

            <!-- Description Message -->
            <TextView
                android:id="@+id/tv_exit_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/task_roboto_regular"
                android:gravity="center"
                android:lineSpacingExtra="4dp"
                android:text="If you exit now, your current test progress will be lost."
                android:textColor="#64748B"
                android:textSize="13.5sp" />

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Exit / Quit Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_confirm_exit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_btn_dialog_secondary"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/task_roboto_bold"
                    android:text="Exit"
                    android:textAllCaps="false"
                    android:textColor="#DC2626"
                    android:textSize="14sp" />

                <!-- Continue Exam Button -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cancel_exit"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1.2"
                    android:minHeight="46dp"
                    android:paddingStart="8dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_btn_dialog_primary"
                    app:backgroundTint="@null"
                    android:fontFamily="@font/task_roboto_bold"
                    android:text="Continue"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
