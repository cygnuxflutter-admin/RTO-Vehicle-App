<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#151E40AF">
    <item>
        <layer-list>
            <!-- 3D Bottom shadow ridge -->
            <item
                android:bottom="0dp"
                android:left="0dp"
                android:right="0dp"
                android:top="2dp">
                <shape android:shape="rectangle">
                    <solid android:color="#CBD5E1" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <!-- Main Card Body -->
            <item
                android:bottom="2dp"
                android:left="0dp"
                android:right="0dp"
                android:top="0dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/white" />
                    <stroke
                        android:width="1dp"
                        android:color="#E2E8F0" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>