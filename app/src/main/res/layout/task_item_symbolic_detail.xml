<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_clean_card_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Symbol Container -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_sign_container"
        android:padding="8dp">

        <ImageView
            android:id="@+id/iv_imgg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mandatory" />
    </FrameLayout>

    <!-- Symbol Description -->
    <TextView
        android:id="@+id/tv_txtt"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:fontFamily="@font/task_roboto_bold"
        android:lineSpacingExtra="2.5dp"
        android:textColor="#0F172A"
        android:textSize="15sp" />

</LinearLayout>