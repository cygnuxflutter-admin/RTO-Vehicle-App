<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#F0F7FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Lock / Premium Badge -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_exam_start_btn"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tv_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/task_roboto_bold"
                    android:text="🔒 PREMIUM QUESTION BANK"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_unlock_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/task_roboto_bold"
                android:gravity="center"
                android:text="૧૫૦+ વધુ પ્રશ્નો અને જવાબો અનલોક કરો"
                android:textColor="#1E293B"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_unlock_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/task_roboto_regular"
                android:gravity="center"
                android:text="RTO પરીક્ષાની સંપૂર્ણ તૈયારી માટે ૧ નાનો વીડિયો જોઈને બાકીના તમામ પ્રશ્નો ફ્રીમાં અનલોક કરો."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Unlock Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_watch_unlock"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_exam_start_btn"
                android:fontFamily="@font/task_roboto_bold"
                android:text="🎬 વીડિયો જુઓ અને અનલોક કરો"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
