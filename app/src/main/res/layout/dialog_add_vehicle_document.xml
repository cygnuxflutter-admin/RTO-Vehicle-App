<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/task_roboto_bold"
                android:text="Add Vehicle to Vault"
                android:textColor="#0F172A"
                android:textSize="17sp" />

            <ImageView
                android:id="@+id/iv_dialog_close"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:src="@drawable/ic_close_clear"
                app:tint="#94A3B8" />
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/task_roboto_regular"
            android:text="Track insurance &amp; PUC expiration reminders"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <!-- Vehicle Number -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/task_roboto_bold"
            android:text="Vehicle Number"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_dialog_veh_number"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_input_modern"
            android:fontFamily="@font/task_roboto_bold"
            android:hint="e.g. GJ 05 AB 1234"
            android:inputType="textCapCharacters"
            android:paddingHorizontal="12dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <!-- Vehicle Name / Nickname -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/task_roboto_bold"
            android:text="Vehicle Name / Model"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_dialog_veh_name"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_input_modern"
            android:fontFamily="@font/task_roboto_regular"
            android:hint="e.g. Honda Activa 6G / Hyundai Creta"
            android:inputType="textCapWords"
            android:paddingHorizontal="12dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <!-- Insurance Expiry Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/task_roboto_bold"
            android:text="Insurance Expiry Date"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_dialog_insurance_date"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_input_modern"
            android:focusable="false"
            android:fontFamily="@font/task_roboto_regular"
            android:hint="Select Insurance Expiry Date"
            android:paddingHorizontal="12dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <!-- PUC Expiry Date -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/task_roboto_bold"
            android:text="PUC Expiry Date"
            android:textColor="#0F172A"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/et_dialog_puc_date"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_search_input_modern"
            android:focusable="false"
            android:fontFamily="@font/task_roboto_regular"
            android:hint="Select PUC Expiry Date"
            android:paddingHorizontal="12dp"
            android:textColor="#0F172A"
            android:textSize="14sp" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_dialog_save_vehicle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_btn_primary_blue"
            android:fontFamily="@font/task_roboto_bold"
            android:text="Save to Vehicle Vault"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
             />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
