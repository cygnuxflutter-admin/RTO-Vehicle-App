<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E40AF"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/iv_back"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/task_roboto_bold"
                    android:text="Used Vehicle Resale Estimator"
                    android:textColor="@color/white"
                    android:textSize="18.5sp" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/task_roboto_regular"
                    android:text="Estimate car &amp; bike market resale value"
                    android:textColor="#E0E7FF"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rlBanner"
        android:layout_below="@+id/header"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="ESTIMATED RESALE VALUE RANGE"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_resale_range"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="₹ 3,85,000 - ₹ 4,20,000"
                        android:textColor="#047857"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/tv_retention_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_regular"
                        android:text="~68% of original value retained"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F1F5F9" />

                    <!-- 2-Column Breakdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/task_roboto_regular"
                                android:text="Expected Deal Price"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_expected_price"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/task_roboto_bold"
                                android:text="₹ 4,02,500"
                                android:textColor="#1E40AF"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/task_roboto_regular"
                                android:text="Total Depreciation"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_depreciation_val"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/task_roboto_bold"
                                android:text="32.9% lost"
                                android:textColor="#DC2626"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Inputs Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Vehicle Type Toggle -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Vehicle Type"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tab_type_car"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="4-Wheeler (Car)"
                            android:textColor="@color/white"
                            android:textSize="12.5sp" />

                        <TextView
                            android:id="@+id/tab_type_bike"
                            android:layout_width="0dp"
                            android:layout_height="36dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="2-Wheeler (Bike/Scooter)"
                            android:textColor="#475569"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <!-- Original Purchase Price -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Original Purchase / Ex-Showroom Price (₹)"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <EditText
                        android:id="@+id/et_original_price"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_input_modern"
                        android:fontFamily="@font/task_roboto_bold"
                        android:hint="e.g. 600000"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:text="600000"
                        android:textColor="#0F172A"
                        android:textSize="15sp" />

                    <!-- Quick Price Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_price_1l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹1 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_price_3l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹3 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_price_6l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹6 Lakh"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_price_10l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹10 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_price_15l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹15 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Vehicle Age -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Vehicle Age (Years)"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_age_1"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="1 Yr"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_age_2"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="2 Yrs"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_age_3"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="3 Yrs"
                            android:textColor="@color/white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_age_5"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="5 Yrs"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_age_7"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="7+ Yrs"
                            android:textColor="#475569"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Kilometers Driven -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Kilometers Driven"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_km_low"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="&lt; 20k km"
                            android:textColor="#475569"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/chip_km_mid"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="20k-50k km"
                            android:textColor="@color/white"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/chip_km_high"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="50k+ km"
                            android:textColor="#475569"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Vehicle Condition -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Vehicle Condition"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_cond_good"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="Good (Normal)"
                            android:textColor="@color/white"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/chip_cond_excel"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="Excellent"
                            android:textColor="#475569"
                            android:textSize="10.5sp" />

                        <TextView
                            android:id="@+id/chip_cond_fair"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="Fair (Serviced)"
                            android:textColor="#475569"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Calculate Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_calc_resale"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_btn_primary_blue"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Estimate Market Value"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                         />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Ad Banner Container -->
    <RelativeLayout
        android:id="@+id/rlBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/rl_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>

</RelativeLayout>
