<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E40AF"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/iv_back"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/task_roboto_bold"
                    android:text="Vehicle Loan &amp; EMI Calculator"
                    android:textColor="@color/white"
                    android:textSize="18.5sp" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/task_roboto_regular"
                    android:text="Car &amp; Bike monthly EMI &amp; interest breakdown"
                    android:textColor="#E0E7FF"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rlBanner"
        android:layout_below="@+id/header"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="MONTHLY EMI"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_emi_amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="₹ 10,501"
                        android:textColor="#1E40AF"
                        android:textSize="28sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_regular"
                        android:text="per month payable"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F1F5F9" />

                    <!-- 3-Column Breakdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/task_roboto_regular"
                                android:text="Principal Loan"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_principal_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/task_roboto_bold"
                                android:text="₹ 5,00,000"
                                android:textColor="#0F172A"
                                android:textSize="14.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/task_roboto_regular"
                                android:text="Total Interest"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_total_interest"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/task_roboto_bold"
                                android:text="₹ 1,30,060"
                                android:textColor="#DC2626"
                                android:textSize="14.5sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/task_roboto_regular"
                                android:text="Total Payable"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_total_amount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/task_roboto_bold"
                                android:text="₹ 6,30,060"
                                android:textColor="#047857"
                                android:textSize="14.5sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Input Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Loan Amount -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Vehicle Loan Amount (₹)"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <EditText
                        android:id="@+id/et_loan_amount"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_input_modern"
                        android:fontFamily="@font/task_roboto_bold"
                        android:hint="e.g. 500000"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:text="500000"
                        android:textColor="#0F172A"
                        android:textSize="15sp" />

                    <!-- Quick Amount Chips -->
                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:scrollbars="none">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_amt_1l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹1 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_amt_3l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹3 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_amt_5l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_selected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹5 Lakh"
                                android:textColor="@color/white"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_amt_10l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:layout_marginEnd="6dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹10 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_amt_15l"
                                android:layout_width="wrap_content"
                                android:layout_height="28dp"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:paddingHorizontal="10dp"
                                android:text="₹15 Lakh"
                                android:textColor="#475569"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Interest Rate -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Interest Rate (% per year)"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <EditText
                        android:id="@+id/et_interest_rate"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_input_modern"
                        android:fontFamily="@font/task_roboto_bold"
                        android:hint="e.g. 9.5"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="14dp"
                        android:text="9.5"
                        android:textColor="#0F172A"
                        android:textSize="15sp" />

                    <!-- Quick Interest Rate Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_rate_85"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="8.5%"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_rate_95"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="9.5%"
                            android:textColor="@color/white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_rate_105"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="10.5%"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_rate_12"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="12.0%"
                            android:textColor="#475569"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Loan Period -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Loan Period (Years)"
                        android:textColor="#0F172A"
                        android:textSize="13.5sp" />

                    <EditText
                        android:id="@+id/et_loan_tenure"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_input_modern"
                        android:fontFamily="@font/task_roboto_bold"
                        android:hint="e.g. 5"
                        android:inputType="number"
                        android:paddingHorizontal="14dp"
                        android:text="5"
                        android:textColor="#0F172A"
                        android:textSize="15sp" />

                    <!-- Quick Tenure Chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/chip_tenure_1"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginEnd="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="1 Yr"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_tenure_3"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="3 Yrs"
                            android:textColor="#475569"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_tenure_5"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginHorizontal="2dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_selected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="5 Yrs"
                            android:textColor="@color/white"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/chip_tenure_7"
                            android:layout_width="0dp"
                            android:layout_height="28dp"
                            android:layout_marginStart="4dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_chip_unselected"
                            android:fontFamily="@font/task_roboto_bold"
                            android:gravity="center"
                            android:text="7 Yrs"
                            android:textColor="#475569"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Calculate Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btn_calculate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_btn_primary_blue"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="Calculate Loan EMI"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                         />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Ad Banner Container -->
    <RelativeLayout
        android:id="@+id/rlBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/rl_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>

</RelativeLayout>
