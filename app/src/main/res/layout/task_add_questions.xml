<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_clean_card_item"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Question Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_question"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_que"
            android:fontFamily="@font/task_roboto_bold"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="પ્રશ્ન"
            android:textColor="#1E40AF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_question_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/task_roboto_bold"
            android:lineSpacingExtra="2dp"
            android:textColor="#0F172A"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Soft Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#F1F5F9" />

    <!-- Answer Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_answer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_ans"
            android:fontFamily="@font/task_roboto_bold"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="જવાબ"
            android:textColor="#16A34A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_answer_data"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/task_roboto_bold"
            android:lineSpacingExtra="2dp"
            android:textColor="#15803D"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>