<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="20dp"
        app:cardElevation="10dp"
        app:cardMaxElevation="12dp"
        app:cardPreventCornerOverlap="true"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <RelativeLayout
                android:id="@+id/native_banner_ad_containers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Update Header Icon -->
            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_dialog_icon_circle">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_dialog_update" />
            </FrameLayout>

            <!-- Dialog Title -->
            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/task_roboto_bold"
                android:gravity="center"
                android:text="New Update Available"
                android:textColor="#0F172A"
                android:textSize="19sp" />

            <!-- Dialog Description -->
            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/task_roboto_regular"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="A newer version of RTO Vehicle Guide is ready with updated 2026 exam questions, faster performance and live fuel rates."
                android:textColor="#64748B"
                android:textSize="13sp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Cancel / Later Button -->
                <TextView
                    android:id="@+id/button1"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_dialog_secondary"
                    android:fontFamily="@font/task_roboto_regular"
                    android:gravity="center"
                    android:text="Later"
                    android:textColor="#475569"
                    android:textSize="14sp" />

                <!-- Update Now Button -->
                <TextView
                    android:id="@+id/button2"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_btn_dialog_primary"
                    android:fontFamily="@font/task_roboto_bold"
                    android:gravity="center"
                    android:text="Update Now"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>