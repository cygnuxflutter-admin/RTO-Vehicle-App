<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1E40AF"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@+id/iv_back"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/task_roboto_bold"
                    android:text="Mileage &amp; Trip Cost Calculator"
                    android:textColor="@color/white"
                    android:textSize="18.5sp" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/task_roboto_regular"
                    android:text="Calculate fuel liters, trip budget &amp; km/L"
                    android:textColor="#E0E7FF"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Tab Switcher -->
    <LinearLayout
        android:id="@+id/ll_tab_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tab_trip_cost"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selected"
            android:fontFamily="@font/task_roboto_bold"
            android:gravity="center"
            android:text="Trip Fuel Cost"
            android:textColor="@color/white"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tab_actual_mileage"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_unselected"
            android:fontFamily="@font/task_roboto_bold"
            android:gravity="center"
            android:text="Tank-to-Tank Mileage"
            android:textColor="#475569"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rlBanner"
        android:layout_below="@+id/ll_tab_container"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Result Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:cardMaxElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_result_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="TOTAL ESTIMATED TRIP COST"
                        android:textColor="#64748B"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_primary_result"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/task_roboto_bold"
                        android:text="₹ 1,304"
                        android:textColor="#1E40AF"
                        android:textSize="28sp" />

                    <TextView
                        android:id="@+id/tv_primary_subtext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/task_roboto_regular"
                        android:text="estimated fuel expense"
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#F1F5F9" />

                    <!-- 2-Column Breakdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_sec_label_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/task_roboto_regular"
                                android:text="Fuel Needed"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_sec_val_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/task_roboto_bold"
                                android:text="13.51 Litres"
                                android:textColor="#0F172A"
                                android:textSize="15sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_sec_label_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/task_roboto_regular"
                                android:text="Cost Per KM"
                                android:textColor="#64748B"
                                android:textSize="11.5sp" />

                            <TextView
                                android:id="@+id/tv_sec_val_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:fontFamily="@font/task_roboto_bold"
                                android:text="₹ 5.22 / km"
                                android:textColor="#047857"
                                android:textSize="15sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Mode 1: Trip Fuel Cost Inputs -->
            <LinearLayout
                android:id="@+id/ll_inputs_trip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Distance -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Distance to Travel (KM)"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/et_trip_distance"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_search_input_modern"
                            android:fontFamily="@font/task_roboto_bold"
                            android:hint="e.g. 250"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="14dp"
                            android:text="250"
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <!-- Fuel Price -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Fuel Price (₹ per Litre)"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/et_trip_fuel_price"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_search_input_modern"
                            android:fontFamily="@font/task_roboto_bold"
                            android:hint="e.g. 96.50"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="14dp"
                            android:text="96.50"
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <!-- Vehicle Mileage -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Vehicle Mileage (KM / Litre)"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/et_trip_mileage"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_search_input_modern"
                            android:fontFamily="@font/task_roboto_bold"
                            android:hint="e.g. 18.5"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="14dp"
                            android:text="18.5"
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <!-- Quick Mileage Chips -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/chip_mil_15"
                                android:layout_width="0dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:text="15 km/l"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_mil_20"
                                android:layout_width="0dp"
                                android:layout_height="28dp"
                                android:layout_marginHorizontal="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:text="20 km/l"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_mil_35"
                                android:layout_width="0dp"
                                android:layout_height="28dp"
                                android:layout_marginHorizontal="2dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:text="35 km/l"
                                android:textColor="#475569"
                                android:textSize="11sp" />

                            <TextView
                                android:id="@+id/chip_mil_50"
                                android:layout_width="0dp"
                                android:layout_height="28dp"
                                android:layout_marginStart="4dp"
                                android:layout_weight="1"
                                android:background="@drawable/bg_chip_unselected"
                                android:fontFamily="@font/task_roboto_bold"
                                android:gravity="center"
                                android:text="50 km/l"
                                android:textColor="#475569"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Calculate Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_calc_trip"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_btn_primary_blue"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Calculate Trip Budget"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                             />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Mode 2: Tank-to-Tank Mileage Inputs -->
            <LinearLayout
                android:id="@+id/ll_inputs_mileage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:cardMaxElevation="0dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Start KM -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Start Odometer Reading (KM)"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/et_odo_start"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_search_input_modern"
                            android:fontFamily="@font/task_roboto_bold"
                            android:hint="e.g. 10000"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="14dp"
                            android:text="12000"
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <!-- End KM -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="End Odometer Reading (KM)"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/et_odo_end"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_search_input_modern"
                            android:fontFamily="@font/task_roboto_bold"
                            android:hint="e.g. 10450"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="14dp"
                            android:text="12450"
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <!-- Fuel Filled Liters -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Total Fuel Filled (Litres)"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/et_fuel_filled"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_search_input_modern"
                            android:fontFamily="@font/task_roboto_bold"
                            android:hint="e.g. 25"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="14dp"
                            android:text="25"
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <!-- Fuel Price (Optional) -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Fuel Price per Litre (₹)"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp" />

                        <EditText
                            android:id="@+id/et_actual_fuel_price"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_search_input_modern"
                            android:fontFamily="@font/task_roboto_bold"
                            android:hint="e.g. 96.50"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="14dp"
                            android:text="96.50"
                            android:textColor="#0F172A"
                            android:textSize="15sp" />

                        <!-- Calculate Button -->
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_calc_mileage"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:layout_marginTop="18dp"
                            android:background="@drawable/bg_btn_primary_blue"
                            android:fontFamily="@font/task_roboto_bold"
                            android:text="Calculate Real Mileage"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                             />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Ad Banner Container -->
    <RelativeLayout
        android:id="@+id/rlBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <RelativeLayout
            android:id="@+id/rl_ad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true" />
    </RelativeLayout>

</RelativeLayout>
