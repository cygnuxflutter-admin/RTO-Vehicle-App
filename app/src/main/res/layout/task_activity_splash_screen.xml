<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Center Hero Branding Container -->
    <LinearLayout
        android:id="@+id/brand_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:layout_marginTop="-20dp">

        <!-- Custom 3D RTO Curved Emblem Logo -->
        <ImageView
            android:id="@+id/iv_splash_logo"
            android:layout_width="165dp"
            android:layout_height="165dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/app_splash_logo" />

        <!-- App Title -->
        <TextView
            android:id="@+id/tv_app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/task_roboto_bold"
            android:letterSpacing="0.02"
            android:text="RTO Exam &amp; Vehicle Guide"
            android:textColor="#0F172A"
            android:textSize="23sp" />

        <!-- App Subtitle -->
        <TextView
            android:id="@+id/tv_app_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/task_roboto_regular"
            android:text="Driving License, Traffic Signs &amp; Services"
            android:textColor="#64748B"
            android:textSize="13.5sp" />

        <!-- Clean Lightweight Loader Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/splash_progress"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:indeterminate="true"
                android:indeterminateTint="#2563EB" />

            <TextView
                android:id="@+id/tv_splash_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/task_roboto_regular"
                android:text="Loading RTO exam questions..."
                android:textColor="#64748B"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom App Version & Badge -->
    <LinearLayout
        android:id="@+id/bottom_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_splash_track"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@drawable/ic_btn_privacy"
            app:tint="#2563EB" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/task_roboto_regular"
            android:text="Official RTO Guide • 100% Free &amp; Secure"
            android:textColor="#1E40AF"
            android:textSize="12sp" />
    </LinearLayout>
</RelativeLayout>